---
import { Icon } from 'astro-icon/components';
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-8 w-8 items-center justify-center rounded-md text-muted transition hover:text-fg dark:text-muted-dark dark:hover:text-fg-dark"
  aria-label="Toggle color theme"
>
  <Icon name="lucide:sun" class="h-4 w-4 dark:hidden" />
  <Icon name="lucide:moon" class="hidden h-4 w-4 dark:block" />
</button>

<script is:inline>
  (function () {
    const button = document.getElementById('theme-toggle');
    if (!button) return;
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (_) {}
    });
  })();
</script>
