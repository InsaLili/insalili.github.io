---
import type { Education } from '../data/types';

interface Props {
  item: Education;
}

const { item } = Astro.props;
---

<article class="py-6">
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-semibold tracking-tight text-fg dark:text-fg-dark">
      {item.school}
    </h3>
    <span class="font-mono text-xs text-muted dark:text-muted-dark">
      {item.dateRange}
    </span>
  </header>
  <p class="mt-1 text-sm text-muted dark:text-muted-dark">
    {item.degree} · {item.field}
  </p>
  {item.note && (
    <p class="mt-2 text-sm italic text-muted dark:text-muted-dark">{item.note}</p>
  )}
  {item.thesis && (
    <p class="mt-3 text-sm">
      Thesis:{' '}
      <a href={item.thesis.href} target="_blank" rel="noopener noreferrer" class="link">
        {item.thesis.title}
      </a>
    </p>
  )}
</article>
