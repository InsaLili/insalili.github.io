---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Lili Tong" />
    <title>{title}</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <link rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#d6a85a" />
    <meta name="msapplication-TileColor" content="#1c1c2a" />
    <meta name="theme-color" content="#231f1a" />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const isLight = stored === 'light';
          if (!isLight) document.documentElement.classList.add('dark');
        } catch (_) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-YWZHVFPKJY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-YWZHVFPKJY');
    </script>
  </head>
  <body class="bg-bg text-fg dark:bg-bg-dark dark:text-fg-dark">
    <slot />
  </body>
</html>
